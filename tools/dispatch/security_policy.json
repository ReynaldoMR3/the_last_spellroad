{
  "denylist_paths": [
    "docker-compose",
    ".github/workflows/",
    "Dockerfile",
    "package.json",
    "package-lock.json",
    ".env",
    ".claude",
    ".codex"
  ],
  "secret_patterns": [
    "sk-[A-Za-z0-9]{20,}",
    "AKIA[0-9A-Z]{16}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  ]
}
